#!/usr/bin/env bash
# Resume the saved Claude Code session for the current directory, or start a new one.
# Usage: rclaude [-r|-c] [extra claude args...]
#   (no flag)  Resume the saved session via "claude --continue" if one exists,
#              otherwise start a new session.
#   -r         Force "claude --resume" for the saved session ID. If no session
#              is saved for this directory, runs plain "claude --resume" so
#              Claude's own picker is shown.
#   -c         Force "claude --continue", regardless of what is or isn't saved
#              in claude-sessions.db.

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DB="${SCRIPT_DIR}/claude-sessions.db"
DIR="$(pwd)"

MODE=""
case "${1:-}" in
    -r|-c) MODE="$1"; shift ;;
esac

SESSION_ID=""
if [[ -f "$DB" ]]; then
    SESSION_ID=$(awk -F'|' -v dir="$DIR" '$1 == dir { print $2; exit }' "$DB")
fi

case "$MODE" in
    -r)
        if [[ -n "$SESSION_ID" ]]; then
            echo "Resuming session $SESSION_ID"
            exec claude --resume "$SESSION_ID" --permission-mode acceptEdits "$@"
        else
            echo "No saved session for $DIR — letting claude --resume pick"
            exec claude --resume --permission-mode acceptEdits "$@"
        fi
        ;;
    -c)
        echo "Continuing most recent session in $DIR"
        exec claude --continue --permission-mode acceptEdits "$@"
        ;;
    *)
        if [[ -n "$SESSION_ID" ]]; then
            echo "Resuming session $SESSION_ID"
            exec claude --continue --permission-mode acceptEdits "$@"
        else
            echo "No saved session for $DIR — starting new session"
            exec claude --permission-mode acceptEdits "$@"
        fi
        ;;
esac
