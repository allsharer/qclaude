#!/usr/bin/env bash
# Edit a saved session entry — update the session ID and/or rename the directory.
# If pwd is in the database: edit that entry directly.
# Otherwise: interactive picker to choose which entry to edit.

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DB="${SCRIPT_DIR}/claude-sessions.db"
DIR="$(pwd)"

if [[ ! -f "$DB" ]] || [[ ! -s "$DB" ]]; then
    echo "No saved sessions." >&2
    exit 1
fi

is_active() {
    local sid="$1" f pid
    for f in "$HOME/.claude/sessions/"*.json; do
        [[ -f "$f" ]] || continue
        grep -qF "\"sessionId\":\"$sid\"" "$f" 2>/dev/null || continue
        pid=$(grep -o '"pid":[0-9]*' "$f" | grep -o '[0-9]*')
        [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && return 0
    done
    return 1
}

encode_path() { echo "$1" | tr '/.' '-'; }

find_project_dir() {
    local path="$1" sid="$2"
    local encoded="$HOME/.claude/projects/$(encode_path "$path")"
    if [[ -d "$encoded" ]]; then echo "$encoded"; return; fi
    local found
    found=$(find "$HOME/.claude/projects" -name "${sid}.jsonl" -maxdepth 2 2>/dev/null | head -1)
    [[ -n "$found" ]] && dirname "$found"
}

find_latest_session() {
    local dir="$HOME/.claude/projects/$(encode_path "$1")"
    [[ -d "$dir" ]] || return 0
    ls -t "$dir"/*.jsonl 2>/dev/null | head -1 | sed 's|.*/||; s|\.jsonl$||'
}

edit_session_id() {
    local path="$1" old_sid="$2"
    local auto_sid new_sid

    auto_sid=$(find_latest_session "$path")
    if [[ -n "$auto_sid" && "$auto_sid" != "$old_sid" ]]; then
        printf "  Auto-detect : %s\n" "$auto_sid"
        printf "  New session ID (Enter to use auto-detected): "
    else
        printf "  New session ID: "
    fi

    read -r new_sid
    new_sid="${new_sid:-$auto_sid}"

    if [[ -z "$new_sid" ]]; then
        echo "No session ID provided — aborted." >&2; return 1
    fi
    if [[ "$new_sid" == "$old_sid" ]]; then
        echo "  Session ID unchanged."; return 0
    fi
    if awk -F'|' -v sid="$new_sid" '$2 == sid { found=1 } END { exit !found }' "$DB"; then
        echo "  Session $new_sid is already saved for another entry — aborted." >&2; return 1
    fi

    awk -F'|' -v p="$path" -v sid="$new_sid" '
        $1 == p { print p "|" sid; next } { print }
    ' "$DB" > "${DB}.tmp" && mv "${DB}.tmp" "$DB"

    echo "  Updated: $old_sid → $new_sid"
}

edit_directory() {
    local old_path="$1" sid="$2"
    local new_path

    printf "  New directory path: "
    read -r new_path

    if [[ -z "$new_path" ]]; then
        echo "  No path provided — aborted." >&2; return 1
    fi
    if [[ "$new_path" == "$old_path" ]]; then
        echo "  Directory unchanged."; return 0
    fi
    if awk -F'|' -v p="$new_path" '$1 == p { found=1 } END { exit !found }' "$DB"; then
        echo "  $new_path is already in the database — aborted." >&2; return 1
    fi

    # Rename the project directory if it exists
    local old_proj new_proj
    old_proj=$(find_project_dir "$old_path" "$sid")
    new_proj="$HOME/.claude/projects/$(encode_path "$new_path")"

    if [[ -n "$old_proj" ]]; then
        if [[ -d "$new_proj" ]]; then
            echo "  $new_proj already exists — aborted." >&2; return 1
        fi
        mv "$old_proj" "$new_proj"
        echo "  Renamed: $old_proj → $new_proj"
    else
        echo "  (project dir not found on disk — updating DB entry only)"
    fi

    awk -F'|' -v old="$old_path" -v new="$new_path" -v sid="$sid" '
        $1 == old { print new "|" sid; next } { print }
    ' "$DB" > "${DB}.tmp" && mv "${DB}.tmp" "$DB"
    echo "  Updated db: $old_path → $new_path"

    # Update history.jsonl so claude --resume can find the session
    local history="$HOME/.claude/history.jsonl"
    if [[ -f "$history" ]]; then
        sed -i "s|\"project\":\"${old_path}\"|\"project\":\"${new_path}\"|g" "$history"
        echo "  Updated history.jsonl"
    fi

    # Update cwd references inside the session jsonl files
    if [[ -n "$new_proj" && -d "$new_proj" ]]; then
        local f
        for f in "$new_proj"/*.jsonl; do
            [[ -f "$f" ]] || continue
            sed -i "s|\"cwd\":\"${old_path}\"|\"cwd\":\"${new_path}\"|g" "$f"
        done
        echo "  Updated session cwd references"
    fi
}

do_edit() {
    local path="$1" sid="$2"

    echo "Directory   : $path"
    echo "Session ID  : $sid"
    if is_active "$sid"; then
        echo $'\033[1;31mError: session is currently active. Exit it before editing.\033[0m'
        return 1
    fi
    echo
    echo "  1) Edit session ID"
    echo "  2) Rename directory"
    echo "  q) Quit"
    echo
    read -r -p "Choice: " choice

    case "$choice" in
        1) edit_session_id "$path" "$sid" ;;
        2) edit_directory  "$path" "$sid" ;;
        q|Q) echo "Aborted." ;;
        *) echo "Invalid choice — aborted." >&2; return 1 ;;
    esac
}

# --- direct path: pwd is in the DB ---

SESSION_ID=$(awk -F'|' -v dir="$DIR" '$1 == dir { print $2; exit }' "$DB")
if [[ -n "$SESSION_ID" ]]; then
    do_edit "$DIR" "$SESSION_ID"
    exit $?
fi

# --- picker: pwd not in DB ---

declare -a PATHS SIDS
while IFS='|' read -r path sid; do
    [[ -z "$path" ]] && continue
    PATHS+=("$path")
    SIDS+=("$sid")
done < "$DB"

if [[ ${#PATHS[@]} -eq 0 ]]; then
    echo "No saved sessions." >&2
    exit 1
fi

selected=0
total=${#PATHS[@]}

stty_saved=$(stty -g)
cleanup() { tput cnorm 2>/dev/null; stty "$stty_saved"; }
trap cleanup EXIT INT TERM
tput civis 2>/dev/null

draw() {
    local redraw="${1:-}"
    if [[ "$redraw" == redraw ]]; then
        tput rc
        tput ed
    fi

    printf "Select a session to edit:\n\n"
    for ((i=0; i<total; i++)); do
        local indicator=""
        is_active "${SIDS[$i]}" && indicator=$' \033[1;32m[active]\033[0m'
        if [[ $i -eq $selected ]]; then
            printf "\033[1;33m>\033[0m %-52s  %s%s\n" "${PATHS[$i]}" "${SIDS[$i]}" "$indicator"
        else
            printf "  %-52s  %s%s\n" "${PATHS[$i]}" "${SIDS[$i]}" "$indicator"
        fi
    done
    printf "\n"
    printf "\033[2m  ↑/↓ move   Enter select   q quit\033[0m\n"
}

clear
tput sc
draw

while true; do
    IFS= read -r -s -n1 key
    if [[ $key == $'\x1b' ]]; then
        IFS= read -r -s -n2 -t 0.05 seq
        key+="$seq"
    fi
    case "$key" in
        $'\x1b[A') ((selected > 0))         && { ((selected--)); draw redraw; } ;;
        $'\x1b[B') ((selected < total - 1)) && { ((selected++)); draw redraw; } ;;
        $'\n'|$'\r'|'') break ;;
        q|Q|$'\x03') echo; echo "Aborted."; exit 0 ;;
    esac
done

tput cnorm 2>/dev/null
stty "$stty_saved"
trap - EXIT INT TERM
printf "\n\n"

do_edit "${PATHS[$selected]}" "${SIDS[$selected]}"
