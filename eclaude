#!/usr/bin/env bash
# Edit a saved session entry, or move a directory (files + all Claude session
# history/metadata) from one location to another.
#
# Usage:
#   eclaude                     If pwd is in the database: edit that entry.
#                                Otherwise: interactive picker to choose one.
#   eclaude --move <src> <dst>  Move <src> to <dst> non-interactively: moves
#                                the files, ~/.claude/projects/ session data,
#                                history.jsonl entries, session cwd fields,
#                                the ~/.claude.json registry entry, and the
#                                claude-sessions.db row (if any) — whether or
#                                not <src> is currently saved in the database.
#                                If <dst> already exists, its contents are
#                                merged rather than overwritten (fails only on
#                                an actual name collision, leaving everything
#                                untouched).
#   eclaude --help              Show this help.

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DB="${SCRIPT_DIR}/claude-sessions.db"
DIR="$(pwd)"

# ---------------------------------------------------------------------------
# Shared helpers
# ---------------------------------------------------------------------------

is_active() {
    local sid="$1" f pid
    for f in "$HOME/.claude/sessions/"*.json; do
        [[ -f "$f" ]] || continue
        grep -qF "\"sessionId\":\"$sid\"" "$f" 2>/dev/null || continue
        pid=$(grep -o '"pid":[0-9]*' "$f" | grep -o '[0-9]*')
        [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && return 0
    done
    return 1
}

encode_path() { printf '%s' "$1" | tr '/.' '-'; }

# Locate a directory's project dir, falling back to a search by session ID
# for cases where the project dir doesn't match the path's current encoding
# (e.g. it was renamed outside of eclaude).
find_project_dir() {
    local path="$1" sid="$2"
    local encoded="$HOME/.claude/projects/$(encode_path "$path")"
    if [[ -d "$encoded" ]]; then echo "$encoded"; return; fi
    [[ -n "$sid" ]] || return 0
    local found
    found=$(find "$HOME/.claude/projects" -name "${sid}.jsonl" -maxdepth 2 2>/dev/null | head -1)
    [[ -n "$found" ]] && dirname "$found"
}

find_latest_session() {
    local dir="$HOME/.claude/projects/$(encode_path "$1")"
    [[ -d "$dir" ]] || return 0
    ls -t "$dir"/*.jsonl 2>/dev/null | head -1 | sed 's|.*/||; s|\.jsonl$||'
}

# Replace a top-level JSON string field's value across one or more files —
# a plain literal substitution (via Python's json.dumps for exact escaping),
# not a regex, so paths containing '.', '*', '\', etc. are handled safely.
# Prints the number of files actually modified (files where the field wasn't
# found are left untouched and don't count).
# patch_json_field FIELD OLD NEW FILE...
patch_json_field() {
    local field="$1" old="$2" new="$3"; shift 3
    [[ $# -gt 0 ]] || { echo 0; return 0; }
    python3 - "$field" "$old" "$new" "$@" <<'PYEOF'
import sys, json
field, old, new = sys.argv[1], sys.argv[2], sys.argv[3]
old_tok = '"%s":%s' % (field, json.dumps(old))
new_tok = '"%s":%s' % (field, json.dumps(new))
changed = 0
for path in sys.argv[4:]:
    with open(path, 'r', encoding='utf-8') as f:
        text = f.read()
    if old_tok in text:
        with open(path, 'w', encoding='utf-8') as f:
            f.write(text.replace(old_tok, new_tok))
        changed += 1
print(changed)
PYEOF
}

# List (one per line) the basenames that exist in both $1 and $2 — i.e. what
# would collide if $1's contents were merged into $2. Prints nothing if $1
# doesn't exist, $2 doesn't exist, or there's no overlap. Prints the sentinel
# __NOT_A_DIR__ if $2 exists but isn't a directory (can't merge into it).
merge_collisions() {
    local src="$1" dst="$2"
    [[ -d "$src" ]] || return 0
    if [[ -e "$dst" && ! -d "$dst" ]]; then
        echo "__NOT_A_DIR__"
        return 0
    fi
    [[ -d "$dst" ]] || return 0
    local entry name
    shopt -s dotglob nullglob
    for entry in "$src"/*; do
        name="$(basename "$entry")"
        [[ -e "$dst/$name" ]] && echo "$name"
    done
    shopt -u dotglob nullglob
}

# Move every entry of $1 into $2. If $2 doesn't exist yet, this is a plain
# rename. If it does, entries are merged into it one by one (caller must have
# already confirmed via merge_collisions that nothing will collide). $1 is
# removed afterward if left empty.
do_merge_move() {
    local src="$1" dst="$2"
    [[ -d "$src" ]] || return 0
    if [[ ! -e "$dst" ]]; then
        mkdir -p "$(dirname "$dst")"
        mv "$src" "$dst"
        return 0
    fi
    local entry
    shopt -s dotglob nullglob
    for entry in "$src"/*; do
        mv "$entry" "$dst/"
    done
    shopt -u dotglob nullglob
    rmdir "$src" 2>/dev/null || true
}

# Rename (or merge) an entry in the ~/.claude.json "projects" registry.
# Prints one of: absent | renamed | kept-destination
update_registry() {
    local old="$1" new="$2" registry="$HOME/.claude.json"
    [[ -f "$registry" ]] || { echo absent; return; }
    python3 - "$registry" "$old" "$new" <<'PYEOF'
import sys, json
path, old, new = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    data = json.load(f)
projects = data.get("projects", {})
if old not in projects:
    print("absent")
    sys.exit(0)
if new in projects:
    projects.pop(old)
    print("kept-destination")
else:
    projects[new] = projects.pop(old)
    print("renamed")
with open(path, "w") as f:
    json.dump(data, f, separators=(",", ":"))
PYEOF
}

# Rename (or merge) a claude-sessions.db row. Prints one of:
# absent | renamed | kept-destination
update_db_entry() {
    local old="$1" new="$2"
    [[ -f "$DB" ]] || { echo absent; return; }
    local old_row new_row
    old_row=$(awk -F'|' -v p="$old" '$1 == p { print; exit }' "$DB")
    [[ -z "$old_row" ]] && { echo absent; return; }
    new_row=$(awk -F'|' -v p="$new" '$1 == p { print; exit }' "$DB")
    if [[ -n "$new_row" ]]; then
        awk -F'|' -v p="$old" '$1 != p' "$DB" > "${DB}.tmp" && mv "${DB}.tmp" "$DB"
        echo kept-destination
        return
    fi
    awk -F'|' -v old="$old" -v new="$new" '
        $1 == old { print new "|" $2; next } { print }
    ' "$DB" > "${DB}.tmp" && mv "${DB}.tmp" "$DB"
    echo renamed
}

# Move everything associated with a directory from OLD_PATH to NEW_PATH:
# the files themselves, Claude's session/project data, history.jsonl entries,
# the cwd recorded inside moved session files, the ~/.claude.json registry
# entry, and the claude-sessions.db row — merging into NEW_PATH if it already
# has any of the above rather than overwriting. SID_HINT is optional and only
# used to help locate a mismatched project dir (see find_project_dir).
#
# Validates every merge up front and makes no changes at all if anything
# would collide.
move_project() {
    local old_path new_path sid_hint="${3:-}"
    old_path="$(readlink -f -- "$1")"
    new_path="$(readlink -f -- "$2")"
    old_path="${old_path%/}"; [[ -z "$old_path" ]] && old_path="/"
    new_path="${new_path%/}"; [[ -z "$new_path" ]] && new_path="/"

    if [[ "$old_path" == "$new_path" ]]; then
        echo "  Source and destination are the same — nothing to do." >&2
        return 1
    fi

    echo "Moving:"
    echo "  from: $old_path"
    echo "  to  : $new_path"
    echo

    local old_proj new_proj
    old_proj="$(find_project_dir "$old_path" "$sid_hint")"
    [[ -z "$old_proj" ]] && old_proj="$HOME/.claude/projects/$(encode_path "$old_path")"
    new_proj="$HOME/.claude/projects/$(encode_path "$new_path")"

    # --- validate both merges up front; change nothing if either would collide ---
    local -a proj_collisions=() fs_collisions=() line
    while IFS= read -r line; do [[ -n "$line" ]] && proj_collisions+=("$line"); done \
        < <(merge_collisions "$old_proj" "$new_proj")
    while IFS= read -r line; do [[ -n "$line" ]] && fs_collisions+=("$line"); done \
        < <(merge_collisions "$old_path" "$new_path")

    if (( ${#proj_collisions[@]} > 0 || ${#fs_collisions[@]} > 0 )); then
        echo "  Error: destination already contains conflicting items — aborted, nothing changed." >&2
        if (( ${#proj_collisions[@]} > 0 )); then
            if [[ "${proj_collisions[0]}" == "__NOT_A_DIR__" ]]; then
                echo "    $new_proj exists and is not a directory" >&2
            else
                printf '    Claude session data conflicts: %s\n' "${proj_collisions[*]}" >&2
            fi
        fi
        if (( ${#fs_collisions[@]} > 0 )); then
            if [[ "${fs_collisions[0]}" == "__NOT_A_DIR__" ]]; then
                echo "    $new_path exists and is not a directory" >&2
            else
                printf '    File conflicts: %s\n' "${fs_collisions[*]}" >&2
            fi
        fi
        return 1
    fi

    # --- 1. Claude's own session/project directory ---
    if [[ -d "$old_proj" ]]; then
        local -a moved_jsonl=() f
        for f in "$old_proj"/*.jsonl; do
            [[ -f "$f" ]] && moved_jsonl+=("$(basename "$f")")
        done
        do_merge_move "$old_proj" "$new_proj"
        echo "  Moved Claude session data: $old_proj -> $new_proj"
        if (( ${#moved_jsonl[@]} > 0 )); then
            local -a patch_files=()
            for f in "${moved_jsonl[@]}"; do
                [[ -f "$new_proj/$f" ]] && patch_files+=("$new_proj/$f")
            done
            local n_patched
            n_patched=$(patch_json_field cwd "$old_path" "$new_path" "${patch_files[@]}")
            (( n_patched > 0 )) && echo "  Updated cwd in $n_patched session file(s)"
        fi
    else
        echo "  (no Claude session data found for this directory)"
    fi

    # --- 2. history.jsonl ---
    local history="$HOME/.claude/history.jsonl"
    if [[ -f "$history" ]]; then
        local n_history
        n_history=$(patch_json_field project "$old_path" "$new_path" "$history")
        (( n_history > 0 )) && echo "  Updated history.jsonl"
    fi

    # --- 3. ~/.claude.json registry ---
    case "$(update_registry "$old_path" "$new_path")" in
        renamed) echo "  Updated ~/.claude.json registry" ;;
        kept-destination)
            echo "  ~/.claude.json already had an entry for $new_path — kept it, discarded the one for $old_path" ;;
    esac

    # --- 4. claude-sessions.db ---
    case "$(update_db_entry "$old_path" "$new_path")" in
        renamed) echo "  Updated claude-sessions.db entry" ;;
        kept-destination)
            echo "  claude-sessions.db already tracked $new_path separately — kept it, dropped the entry for $old_path" ;;
    esac

    # --- 5. the actual files ---
    if [[ -d "$old_path" ]]; then
        do_merge_move "$old_path" "$new_path"
        echo "  Moved files: $old_path -> $new_path"
    else
        echo "  (source directory not found on disk — skipping file move)"
    fi

    echo
    echo "Done. \"claude --resume\" / \"claude --continue\" from $new_path will pick this up."
    return 0
}

# ---------------------------------------------------------------------------
# Interactive edit menu
# ---------------------------------------------------------------------------

edit_session_id() {
    local path="$1" old_sid="$2"
    local auto_sid new_sid

    auto_sid=$(find_latest_session "$path")
    if [[ -n "$auto_sid" && "$auto_sid" != "$old_sid" ]]; then
        printf "  Auto-detect : %s\n" "$auto_sid"
        printf "  New session ID (Enter to use auto-detected): "
    else
        printf "  New session ID: "
    fi

    read -r new_sid
    new_sid="${new_sid:-$auto_sid}"

    if [[ -z "$new_sid" ]]; then
        echo "No session ID provided — aborted." >&2; return 1
    fi
    if [[ "$new_sid" == "$old_sid" ]]; then
        echo "  Session ID unchanged."; return 0
    fi
    if awk -F'|' -v sid="$new_sid" '$2 == sid { found=1 } END { exit !found }' "$DB"; then
        echo "  Session $new_sid is already saved for another entry — aborted." >&2; return 1
    fi

    awk -F'|' -v p="$path" -v sid="$new_sid" '
        $1 == p { print p "|" sid; next } { print }
    ' "$DB" > "${DB}.tmp" && mv "${DB}.tmp" "$DB"

    echo "  Updated: $old_sid → $new_sid"
}

edit_directory() {
    local old_path="$1" sid="$2" new_path
    printf "  New directory path: "
    read -r new_path

    if [[ -z "$new_path" ]]; then
        echo "  No path provided — aborted." >&2; return 1
    fi
    move_project "$old_path" "$new_path" "$sid"
}

do_edit() {
    local path="$1" sid="$2"

    echo "Directory   : $path"
    echo "Session ID  : $sid"
    if is_active "$sid"; then
        echo $'\033[1;31mError: session is currently active. Exit it before editing.\033[0m'
        return 1
    fi
    echo
    echo "  1) Edit session ID"
    echo "  2) Move directory"
    echo "  q) Quit"
    echo
    read -r -p "Choice: " choice

    case "$choice" in
        1) edit_session_id "$path" "$sid" ;;
        2) edit_directory  "$path" "$sid" ;;
        q|Q) echo "Aborted." ;;
        *) echo "Invalid choice — aborted." >&2; return 1 ;;
    esac
}

# ---------------------------------------------------------------------------
# Non-interactive CLI dispatch (must come after all function definitions —
# bash resolves functions top-to-bottom as it executes)
# ---------------------------------------------------------------------------

case "${1:-}" in
    --move)
        if [[ $# -ne 3 ]]; then
            echo "Usage: eclaude --move <source-dir> <destination-dir>" >&2
            exit 1
        fi
        move_project "$2" "$3"
        exit $?
        ;;
    -h|--help)
        sed -n '2,18p' "$(readlink -f "${BASH_SOURCE[0]}")" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

if [[ ! -f "$DB" ]] || [[ ! -s "$DB" ]]; then
    echo "No saved sessions." >&2
    exit 1
fi

# --- direct path: pwd is in the DB ---

SESSION_ID=$(awk -F'|' -v dir="$DIR" '$1 == dir { print $2; exit }' "$DB")
if [[ -n "$SESSION_ID" ]]; then
    do_edit "$DIR" "$SESSION_ID"
    exit $?
fi

# --- picker: pwd not in DB ---

declare -a PATHS SIDS
while IFS='|' read -r path sid; do
    [[ -z "$path" ]] && continue
    PATHS+=("$path")
    SIDS+=("$sid")
done < "$DB"

if [[ ${#PATHS[@]} -eq 0 ]]; then
    echo "No saved sessions." >&2
    exit 1
fi

selected=0
total=${#PATHS[@]}
top=0

stty_saved=$(stty -g)
cleanup() { tput cnorm 2>/dev/null; stty "$stty_saved"; }
trap cleanup EXIT INT TERM
tput civis 2>/dev/null

# Session rows that fit on screen, leaving room for the header (2 lines),
# the two scroll indicators, and the footer (2 lines).
page_size() {
    local lines
    lines=$(tput lines 2>/dev/null) || lines=24
    local p=$((lines - 6))
    ((p < 1)) && p=1
    printf '%s' "$p"
}

draw() {
    local redraw="${1:-}"
    if [[ "$redraw" == redraw ]]; then
        tput rc
        tput ed
    fi

    local page end
    page=$(page_size)
    ((selected < top)) && top=$selected
    ((selected >= top + page)) && top=$((selected - page + 1))
    ((top > total - page)) && top=$((total - page))
    ((top < 0)) && top=0
    end=$((top + page))
    ((end > total)) && end=$total

    printf "Select a session to edit:\n\n"
    if ((top > 0)); then
        printf "\033[2m  ↑ %d more above\033[0m\n" "$top"
    else
        printf "\n"
    fi
    for ((i=top; i<end; i++)); do
        local indicator=""
        is_active "${SIDS[$i]}" && indicator=$' \033[1;32m[active]\033[0m'
        if [[ $i -eq $selected ]]; then
            printf "\033[1;33m>\033[0m %-52s  %s%s\n" "${PATHS[$i]}" "${SIDS[$i]}" "$indicator"
        else
            printf "  %-52s  %s%s\n" "${PATHS[$i]}" "${SIDS[$i]}" "$indicator"
        fi
    done
    if ((end < total)); then
        printf "\033[2m  ↓ %d more below\033[0m\n" "$((total - end))"
    else
        printf "\n"
    fi
    printf "\n"
    printf "\033[2m  ↑/↓ move   PgUp/PgDn page   Home/End jump   Enter select   q quit\033[0m\n"
}

clear
tput sc
draw

while true; do
    IFS= read -r -s -n1 key
    if [[ $key == $'\x1b' ]]; then
        IFS= read -r -s -n2 -t 0.05 seq
        key+="$seq"
        if [[ $seq == '['[0-9] ]]; then
            IFS= read -r -s -n1 -t 0.05 seq2
            key+="$seq2"
        fi
    fi
    case "$key" in
        $'\x1b[A') ((selected > 0))         && { ((selected--)); draw redraw; } ;;
        $'\x1b[B') ((selected < total - 1)) && { ((selected++)); draw redraw; } ;;
        $'\x1b[5~'|$'\x1b[6~'|$'\x1b[H'|$'\x1b[F'|$'\x1b[1~'|$'\x1b[4~')
            page=$(page_size)
            case "$key" in
                $'\x1b[5~') ((selected -= page)) ;;
                $'\x1b[6~') ((selected += page)) ;;
                $'\x1b[H'|$'\x1b[1~') selected=0 ;;
                $'\x1b[F'|$'\x1b[4~') selected=$((total - 1)) ;;
            esac
            ((selected < 0)) && selected=0
            ((selected > total - 1)) && selected=$((total - 1))
            draw redraw
            ;;
        $'\n'|$'\r'|'') break ;;
        q|Q|$'\x03') echo; echo "Aborted."; exit 0 ;;
    esac
done

tput cnorm 2>/dev/null
stty "$stty_saved"
trap - EXIT INT TERM
printf "\n\n"

do_edit "${PATHS[$selected]}" "${SIDS[$selected]}"
