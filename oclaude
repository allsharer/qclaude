#!/usr/bin/env bash
# Interactive session picker. Select a saved session to resume.
# Active sessions are shown but cannot be launched (already running).
# Note: the selected directory becomes the cwd for the claude process;
# your shell's working directory is unchanged after claude exits.

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DB="${SCRIPT_DIR}/claude-sessions.db"

if [[ ! -f "$DB" ]] || [[ ! -s "$DB" ]]; then
    echo "No saved sessions." >&2
    exit 1
fi

is_active() {
    local sid="$1" f pid
    for f in "$HOME/.claude/sessions/"*.json; do
        [[ -f "$f" ]] || continue
        grep -qF "\"sessionId\":\"$sid\"" "$f" 2>/dev/null || continue
        pid=$(grep -o '"pid":[0-9]*' "$f" | grep -o '[0-9]*')
        [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && return 0
    done
    return 1
}

declare -a PATHS SIDS ACTIVE
while IFS='|' read -r path sid; do
    [[ -z "$path" ]] && continue
    PATHS+=("$path")
    SIDS+=("$sid")
    is_active "$sid" && ACTIVE+=(1) || ACTIVE+=(0)
done < "$DB"

if [[ ${#PATHS[@]} -eq 0 ]]; then
    echo "No saved sessions." >&2
    exit 1
fi

selected=0
total=${#PATHS[@]}
top=0
msg=""

stty_saved=$(stty -g)
cleanup() { tput cnorm 2>/dev/null; stty "$stty_saved"; }
trap cleanup EXIT INT TERM
tput civis 2>/dev/null

# Number of session rows that fit on screen, leaving room for the header
# (2 lines), the two scroll indicators, and the footer (2 lines).
page_size() {
    local lines
    lines=$(tput lines 2>/dev/null) || lines=24
    local p=$((lines - 6))
    ((p < 1)) && p=1
    printf '%s' "$p"
}

draw() {
    local redraw="${1:-}"
    if [[ "$redraw" == redraw ]]; then
        printf '\0338'   # restore cursor (VT100)
        printf '\033[J'  # erase to end of screen
    fi

    local page end
    page=$(page_size)
    # Keep the selected row within the visible window.
    ((selected < top)) && top=$selected
    ((selected >= top + page)) && top=$((selected - page + 1))
    ((top > total - page)) && top=$((total - page))
    ((top < 0)) && top=0
    end=$((top + page))
    ((end > total)) && end=$total

    printf "Select a session to resume:\n\n"
    if ((top > 0)); then
        printf "\033[2m  ↑ %d more above\033[0m\n" "$top"
    else
        printf "\n"
    fi
    for ((i=top; i<end; i++)); do
        local tag=""
        [[ ${ACTIVE[$i]} -eq 1 ]] && tag=$'  \033[2m[active]\033[0m'
        if [[ $i -eq $selected ]]; then
            printf "\033[1;33m>\033[0m %-45s  \033[2m%s\033[0m%s\n" "${PATHS[$i]}" "${SIDS[$i]}" "$tag"
        else
            printf "  %-45s  \033[2m%s\033[0m%s\n" "${PATHS[$i]}" "${SIDS[$i]}" "$tag"
        fi
    done
    if ((end < total)); then
        printf "\033[2m  ↓ %d more below\033[0m\n" "$((total - end))"
    else
        printf "\n"
    fi
    printf "\n"
    if [[ -n "$msg" ]]; then
        printf "\033[1;31m  %s\033[0m\n" "$msg"
    else
        printf "\033[2m  ↑/↓ move   PgUp/PgDn page   Home/End jump   Enter select   q quit\033[0m\n"
    fi
}

clear
printf '\0337'  # save cursor (VT100)
draw

while true; do
    IFS= read -r -s -n1 key
    if [[ $key == $'\x1b' ]]; then
        IFS= read -r -s -n2 -t 0.05 seq
        key+="$seq"
        # Some sequences (PgUp/PgDn, Home/End) carry a trailing '~'.
        if [[ $seq == '['[0-9] ]]; then
            IFS= read -r -s -n1 -t 0.05 seq2
            key+="$seq2"
        fi
    fi
    case "$key" in
        $'\x1b[A')
            if ((selected > 0)); then
                ((selected--)); msg=""; draw redraw
            fi
            ;;
        $'\x1b[B')
            if ((selected < total - 1)); then
                ((selected++)); msg=""; draw redraw
            fi
            ;;
        $'\x1b[5~'|$'\x1b[6~'|$'\x1b[H'|$'\x1b[F'|$'\x1b[1~'|$'\x1b[4~')
            page=$(page_size)
            case "$key" in
                $'\x1b[5~') ((selected -= page)) ;;
                $'\x1b[6~') ((selected += page)) ;;
                $'\x1b[H'|$'\x1b[1~') selected=0 ;;
                $'\x1b[F'|$'\x1b[4~') selected=$((total - 1)) ;;
            esac
            ((selected < 0)) && selected=0
            ((selected > total - 1)) && selected=$((total - 1))
            msg=""; draw redraw
            ;;
        $'\n'|$'\r'|'')
            if [[ ${ACTIVE[$selected]} -eq 1 ]]; then
                msg="Session is already active — exit it first."
                draw redraw
            else
                break
            fi
            ;;
        q|Q|$'\x03')
            echo; exit 0
            ;;
    esac
done

tput cnorm 2>/dev/null
stty "$stty_saved"
trap - EXIT INT TERM
printf "\n"

cd "${PATHS[$selected]}" && exec claude --continue --permission-mode acceptEdits
